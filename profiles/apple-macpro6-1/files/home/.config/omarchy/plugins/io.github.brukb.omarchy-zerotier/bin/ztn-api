#!/usr/bin/env bash
# Ztnodes backend — ZeroTier Service API (no build step).
set -u
set -o pipefail
export LC_ALL=C
umask 077

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$ROOT/lib/common.sh"
# shellcheck source=lib/auth.sh
source "$ROOT/lib/auth.sh"
# shellcheck source=lib/http.sh
source "$ROOT/lib/http.sh"
# shellcheck source=lib/controller.sh
source "$ROOT/lib/controller.sh"
# shellcheck source=lib/snapshot.sh
source "$ROOT/lib/snapshot.sh"

usage() {
  cat <<'EOF' >&2
Usage: ztn-api <command> [args…]

Commands:
  auth status              Token presence (never prints token)
  auth store               Read token from stdin, store in keyring
  auth clear               Remove stored tokens from all keyring entries

  snapshot                  Full panel refresh (auth+status+networks+controller+peers)

  status                   GET /status
  networks                 GET /network
  network get <nwid>       GET /network/{id}
  network join <nwid>      POST /network/{id}
  network leave <nwid>     DELETE /network/{id}
  network set <nwid> <key> <bool>
                           Keys: allowDNS allowDefault allowGlobal allowManaged
  peers                    GET /peer
  controller status        GET /controller
  controller networks      List controller networks (full detail)
  controller network get <nwid>
  controller network create        Read JSON from stdin (quick create)
  controller network create-blank  Minimal random-id network
  controller network update <nwid> Read JSON from stdin
  controller network delete <nwid>
  controller members <nwid>
  controller member update <nwid> <node>  Read JSON from stdin
  controller member delete <nwid> <node>
EOF
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    auth)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        status) auth_status_json ;;
        store) auth_store_stdin ;;
        clear) auth_clear ;;
        *) usage; exit 2 ;;
      esac
      ;;
    status) cmd_status ;;
    snapshot) cmd_snapshot ;;
    networks) cmd_networks ;;
    network)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        get) cmd_network_get "${1:-}" ;;
        join) cmd_network_join "${1:-}" ;;
        leave) cmd_network_leave "${1:-}" ;;
        set) cmd_network_set "${1:-}" "${2:-}" "${3:-}" ;;
        *) usage; exit 2 ;;
      esac
      ;;
    peers) cmd_peers ;;
    controller)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        status) cmd_controller_status ;;
        networks) cmd_controller_networks_full ;;
        network)
          local net_sub="${1:-}"
          shift || true
          case "$net_sub" in
            get) cmd_controller_network_get "${1:-}" ;;
            create) cmd_controller_network_create_stdin ;;
            create-blank) cmd_controller_network_create_blank ;;
            update) cmd_controller_network_update_stdin "${1:-}" ;;
            delete) cmd_controller_network_delete "${1:-}" ;;
            *) usage; exit 2 ;;
          esac
          ;;
        members) cmd_controller_members "${1:-}" ;;
        member)
          local mem_sub="${1:-}"
          shift || true
          case "$mem_sub" in
            update) cmd_controller_member_update_stdin "${1:-}" "${2:-}" ;;
            delete) cmd_controller_member_delete "${1:-}" "${2:-}" ;;
            *) usage; exit 2 ;;
          esac
          ;;
        *) usage; exit 2 ;;
      esac
      ;;
    ""|-h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
